FROM golang:1.26 AS builder
WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o agentic-trigger ./cmd/agentic-trigger/

FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/agentic-trigger .
USER 65532:65532
ENTRYPOINT ["/agentic-trigger"]
